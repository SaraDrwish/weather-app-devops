# =========================================================
# Dockerfile = "وصفة" بناء الـ image
# كل سطر هنا اسمه instruction، وكل واحدة بتعمل "طبقة" (layer) في الـ image
# =========================================================

# FROM: نقطة البداية. بناخد image جاهزة ونبني فوقها
#   nginx  = سيرفر ويب، شغلته يستقبل طلبات المتصفح ويرد بالملفات
#   alpine = نسخة Linux صغيرة جدًا (حوالي 5 ميجا)، فالـ image خفيفة وسريعة
#   الفايدة: مش محتاجين نسطب ونظبط سيرفر ويب بنفسنا
FROM nginx:alpine

# COPY: ننسخ ملفاتنا من جهازنا لجوه الـ image
#   /usr/share/nginx/html/ = الفولدر اللي nginx بيعرض منه الصفحات تلقائيًا
#   الفايدة: الملفات تبقى جزء من الصندوق، فيشتغل في أي مكان بنفس الشكل
COPY index.html style.css app.js /usr/share/nginx/html/

# EXPOSE: توثيق إن التطبيق جوه الصندوق شغال على port 80
#   ملحوظة: ده مش بيفتح الـ port فعليًا، اللي بيفتحه -p في أمر docker run
EXPOSE 80

# HEALTHCHECK: Docker يكشف كل 30 ثانية إن السيرفر لسه بيرد
#   wget -q --spider = يطلب الصفحة من غير ما ينزلها، بس يتأكد إنها موجودة
#   || exit 1 = لو الطلب فشل، الكشف يفشل، و docker ps هيكتب (unhealthy)
#   الفايدة: نعرف إن التطبيق واقع حتى لو الـ container نفسه لسه شغال
HEALTHCHECK --interval=30s --timeout=3s CMD wget -q --spider http://localhost/ || exit 1

# مفيش CMD هنا لأن nginx:alpine فيها CMD جاهز بيشغل السيرفر
